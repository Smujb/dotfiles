### Variables
#
# Logo key.
set $mod Mod4
set $alt Mod1
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
# Recommends: foot
set $term foot
# Your preferred application launcher
# Kill fuzzel if already running, run it if it isn't
set $menu pgrep fuzzel >/dev/null 2>&1 && killall fuzzel || fuzzel

# Set colour scheme (~/.config/sway/colourschemes/)
# Themes are from https://github.com/rkubosz/base16-sway, not included in this repository
set $colourscheme base16-rose-pine-moon.config

# Nicer names for mouse buttons
set $mouse_left button1
set $mouse_right button3
set $mouse_middle button2

set $mouse_scroll_up button4
set $mouse_scroll_down button5

set $mouse_side_1 button8
set $mouse_side_2 button9

# Warp the mouse when moving focus between windows, not just displays
mouse_warping container

# Swaynag theme
swaynag_command swaynag --background eabbec --text 0e0e16 --button-text 0e0e16 --button-background d76ba6 --button-border d76b70 --button-padding 6 --details-background d76b70 --edge bottom
### Key bindings
#
# Basics:
#
    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Show wlogout
    bindsym $mod+Shift+e exec pgrep wlogout >/dev/null 2>&1 && killall wlogout || wlogout

# Moving around:
#
    bindsym $alt+$left exec wtype -P left -p left
    bindsym $alt+$down exec wtype -P down -p down
    bindsym $alt+$up exec wtype -P up -p up
    bindsym $alt+$right exec wtype -P right -p right
    
    # Move your focus around (disabled for now)
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
# 
# Switch to workspace
    bindsym $mod+1 workspace number $$ws_1
    bindsym $mod+2 workspace number $$ws_2
    bindsym $mod+3 workspace number $$ws_3
    bindsym $mod+4 workspace number $$ws_4
    bindsym $mod+5 workspace number $$ws_5
    bindsym $mod+6 workspace number $$ws_6
    bindsym $mod+7 workspace number $$ws_7
    bindsym $mod+8 workspace number $$ws_8
    bindsym $mod+9 workspace number $$ws_9
    bindsym $mod+0 workspace number $$ws_10

    bindsym $mod+bracketleft workspace prev_on_output
    bindsym $mod+bracketright workspace next_on_output
   
    # Use mod + scroll wheel to navigate workspaces also
    bindsym --whole-window $mod+$mouse_scroll_up workspace prev_on_output
    bindsym --whole-window $mod+$mouse_scroll_down workspace next_on_output

    # Use mod + shift + scroll wheel to snap focus, useful for snapping between displays
    bindsym --whole-window $mod+Shift+$mouse_scroll_up focus left
    bindsym --whole-window $mod+Shift+$mouse_scroll_down focus right

    # Move focused container to workspace and do not follow
    bindsym $mod+Control+1 move container to workspace number $$ws_1
    bindsym $mod+Control+2 move container to workspace number $$ws_2
    bindsym $mod+Control+3 move container to workspace number $$ws_3
    bindsym $mod+Control+4 move container to workspace number $$ws_4
    bindsym $mod+Control+5 move container to workspace number $$ws_5
    bindsym $mod+Control+6 move container to workspace number $$ws_6
    bindsym $mod+Control+7 move container to workspace number $$ws_7
    bindsym $mod+Control+8 move container to workspace number $$ws_8
    bindsym $mod+Control+9 move container to workspace number $$ws_9
    bindsym $mod+Control+0 move container to workspace number $$ws_10

    # Move focused container to workspace and follow
    bindsym $mod+Shift+1 move container to workspace number 1; workspace number $$ws_1
    bindsym $mod+Shift+2 move container to workspace number 2; workspace number $$ws_2
    bindsym $mod+Shift+3 move container to workspace number 3; workspace number $$ws_3
    bindsym $mod+Shift+4 move container to workspace number 4; workspace number $$ws_4
    bindsym $mod+Shift+5 move container to workspace number 5; workspace number $$ws_5
    bindsym $mod+Shift+6 move container to workspace number 6; workspace number $$ws_6
    bindsym $mod+Shift+7 move container to workspace number 7; workspace number $$ws_7
    bindsym $mod+Shift+8 move container to workspace number 8; workspace number $$ws_8
    bindsym $mod+Shift+9 move container to workspace number 9; workspace number $$ws_9
    bindsym $mod+Shift+0 move container to workspace number 10; workspace number $$ws_10

#
# Layout stuff:
# 
    # Make the current focus fullscreen
    bindsym $mod+f fullscreen
    bindsym --whole-window $mod+$mouse_middle fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle
    bindsym --whole-window $mod+$mouse_side_1 floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle
    bindsym --whole-window $mod+$mouse_side_2 focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
# Set window border colours
include ~/.config/sway/colourschemes/$colourscheme

# Basic color configuration using the Base16 variables for windows and borders.
# Property Name         Border  BG      Text    Indicator Child Border
client.focused          $base05 $base0D $base00 $base0D $base0D
client.focused_inactive $base01 $base01 $base05 $base03 $base01
client.unfocused        $base01 $base00 $base05 $base01 $base01
client.urgent           $base08 $base08 $base00 $base08 $base08
client.placeholder      $base00 $base00 $base05 $base00 $base00
client.background       $base07

# Delay changing the window's colour back from "urgent"
force_display_urgency_hint 500 ms

# Floating windows have title bars, tiled windows do not
default_border pixel
default_floating_border normal

# Gaps between windows
gaps inner 8px

# Include configs from 3 locations:
#  - /usr/share/sway/config.d
#  - /etc/sway/config.d
#  - $XDG_CONFIG_HOME/sway/config.d ($HOME/.config/sway/config.d)
#
# If multiple directories contain the files with the same name, the later
# directory takes precedence; `$XDG_CONFIG_HOME/sway/config.d/20-swayidle.conf`
# will always be loaded instead of `/usr/share/sway/config.d/20-swayidle.conf`
# or `/etc/sway/config.d/20-swayidle.conf`
#
# This mechanism permits overriding our default configuration per-system
# (/etc) or per-user ($XDG_CONFIG_HOME) basis. Just create the file you
# want to modify/override in the higher-level directory.
#
# For example, to disable the default bar from Fedora configs, you'll need to
#     $ echo -n > "$HOME/.config/sway/config.d/90-bar.conf"
#
# Note the quoting, the $() and the arguments quoting. All the parts are equally
# important to make the magic work. And if you want to learn the secret behind
# the trick, it's all in the `wordexp(3)`.
#
include "/usr/share/sway/config.d/*.conf"
include "/etc/sway/config.d/*.conf"
include "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf"
