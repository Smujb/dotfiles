{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "height": 15,
    "width": 30,
    "padding": {
      "top": 1
    },
    "color": {
      "1": "magenta",
      "2": "magenta"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "blue",
      "keys": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "color": {
        "user": "light_blue",
        "at": "white",
        "host": "magenta"
      }
    },
    "break",
    {
      "type": "os",
      "key": " 🗐",
      "format": "{pretty-name}"
    },
    {
      "type": "command",
      "key": " 󱋩",
      "text": "source /etc/os-release && echo $ID:$IMAGE_VERSION"
    },
    {
      "type": "kernel",
      "key": " ",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": " 󰅐"
    },
    {
      "type": "command",
      "key": " 󰃯",
      "text": "birth_install=$(stat -c %W /var); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
    },
    "break",
    {
      "type": "host",
      "key": " 󰾰",
      "format": "{vendor} {name}"
    },
    {
      "type": "cpu",
      "key": " 󰻠"
    },
    {
      "type": "gpu",
      "key": " 󰍛"
    },
    {
      "type": "memory",
      "key": " "
    },
    {
      "type": "disk",
      "key": " ",
      "hideFS": "overlay:erofs"
    },
    {
      "type": "display",
      "key": " 󰍹",
      "format": "{width}x{height} @ {refresh-rate}Hz [{type} {inch}\" - {name}]"
    },
    {
      "type": "battery",
      "key": " "
    },
    {
      "type": "gamepad",
      "key": " 󰖺",
      "ignores": [
        "extest"
      ]
    },
    "break",
    {
      "type": "wm",
      "key": " "
    },
    {
      "type": "shell",
      "key": " "
    },
    {
      "type": "terminal",
      "key": " "
    },
    {
      "type": "packages",
      "key": " 󰏖"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}